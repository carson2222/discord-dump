{
  "manifest_version": 3,
  "name": "discord-dump",
  "version": "1.0.0",
  "description": "Export a Discord channel as one compact text file for LLM agents.",
  "action": { "default_title": "discord-dump" },
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": ["https://discord.com/*"],
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["format.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
